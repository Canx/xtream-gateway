# Server Port (default: 8888)
PORT=8888

# Public Hostname or IP of this proxy (used for rewriting server_info responses)
# If left blank, it will dynamically detect the incoming Host header
PROXY_HOST=127.0.0.1

# Secret salt used for HMAC signing of /cdn/ chunk URLs
# Change this to a random string in production
CDN_SECRET=replace_with_a_secure_random_string_2026

# Path to the providers configuration file
PROVIDERS_FILE=./providers.json
